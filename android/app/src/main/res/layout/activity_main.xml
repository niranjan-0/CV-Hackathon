<?xml version="1.0" encoding="utf-8"?>
<!--
  Drop-in replacement for android/app/src/main/res/layout/activity_main.xml
  All view IDs are identical to the original: prompt, budget, variant, provider,
  post, generate, progress, image, log — no Kotlin changes needed.
  Requires: add colors to res/values/colors.xml (see bottom of this file for the block to paste).
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- ── Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="#6C63FF"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FurnitAR Generate"
                    android:textColor="#EEEEF0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="On-device · SD 1.5 + LCM"
                    android:textColor="#6B6B80"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- live status dot -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_idle" />
        </LinearLayout>

        <!-- ── Prompt card ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prompt"
                android:textColor="#6C63FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:hint="Describe the image…"
                android:textColor="#EEEEF0"
                android:textColorHint="#44445A"
                android:textSize="14sp"
                android:minLines="3"
                android:maxLines="6"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:text="a red cube on top of a blue sphere, next to a green pyramid, on a wooden table" />

            <!-- Negative prompt separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E1E2A"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Negative Prompt"
                android:textColor="#6C63FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/negative_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:hint="Things to avoid… blurry, low quality, distorted"
                android:textColor="#EEEEF0"
                android:textColorHint="#44445A"
                android:textSize="13sp"
                android:minLines="2"
                android:maxLines="4"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences" />
        </LinearLayout>

        <!-- ── Settings card ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#6C63FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <!-- Budget row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Budget"
                    android:textColor="#A0A0B8"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/budget"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:popupBackground="#1A1A24" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E1E2A"
                android:layout_marginBottom="8dp" />

            <!-- Model row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Model"
                    android:textColor="#A0A0B8"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/variant"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:popupBackground="#1A1A24" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E1E2A"
                android:layout_marginBottom="8dp" />

            <!-- Provider row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Provider"
                    android:textColor="#A0A0B8"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/provider"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:popupBackground="#1A1A24" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E1E2A"
                android:layout_marginBottom="4dp" />

            <!-- Post-process toggle -->
            <CheckBox
                android:id="@+id/post"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="OpenCV post-processing"
                android:textColor="#A0A0B8"
                android:textSize="13sp"
                android:checked="true"
                android:buttonTint="#6C63FF" />
        </LinearLayout>

        <!-- ── Generate button ── -->
        <Button
            android:id="@+id/generate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Generate"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.04"
            android:background="@drawable/btn_generate"
            android:layout_marginBottom="16dp"
            android:stateListAnimator="@null" />

        <!-- ── Progress bar ── -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="#6C63FF"
            android:visibility="invisible"
            android:layout_marginBottom="16dp" />

        <!-- ── Image output ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/image_frame"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:padding="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:text="on-device"
                android:textColor="#55FFFFFF"
                android:textSize="10sp"
                android:background="#66000000"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_margin="6dp" />
        </FrameLayout>

        <!-- ── Save / Share row (hidden until image is generated) ── -->
        <LinearLayout
            android:id="@+id/saveShareRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <!-- Save to Gallery -->
            <Button
                android:id="@+id/saveBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="⬇ Save to Gallery"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/btn_save"
                android:layout_marginEnd="6dp"
                android:stateListAnimator="@null" />

            <!-- Share -->
            <Button
                android:id="@+id/shareBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="↗ Share"
                android:textSize="13sp"
                android:textColor="#6C63FF"
                android:textStyle="bold"
                android:background="@drawable/btn_share"
                android:layout_marginStart="6dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ── Metrics / log ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metrics"
                android:textColor="#6C63FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#8888A0"
                android:lineSpacingMultiplier="1.4"
                android:textIsSelectable="true" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

